# Токен доступа к T-Bank Invest API (необязателен для демо с кэшем)
# Получить можно в личном кабинете Т-Инвестиций: Настройки -> Токены
T_INVEST_TOKEN=

# API ключ для OpenAI-совместимой LLM (OpenAI, DeepSeek, OpenRouter, vLLM и т.д.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
